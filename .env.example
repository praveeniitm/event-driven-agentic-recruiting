# Copy to .env and edit. PROD: inject secrets from a vault / secret manager, never a file in the repo.

# --- Kafka (host-side services talk to the EXTERNAL listener) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- LLM ---
# openai = real calls, mock = deterministic offline stub (no key, no cost, used by tests and CI)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o   # used only by `make eval JUDGE=1`
LLM_TIMEOUT_SECONDS=30

# --- Postgres (written by Kafka Connect, read by the dashboard) ---
POSTGRES_DSN=postgresql://recruiting:recruiting@localhost:5432/recruiting
